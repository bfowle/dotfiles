# .clangd configuration for Unreal Engine projects
#
# INSTALLATION:
#   Copy this file to your Unreal project root as `.clangd`
#   Example: cp ~/.dotfiles/.claude/templates/unreal-clangd-config /path/to/YourProject/.clangd
#
# This suppresses common clangd errors in Unreal Engine projects
# when compile_commands.json is not available

CompileFlags:
  Add:
    # Unreal Engine uses C++17 (UE5.3+ uses C++20)
    - -std=c++20
    # Suppress warnings that Unreal generates
    - -Wno-unused-parameter
    - -Wno-unused-variable
    - -Wno-deprecated-declarations
    - -Wno-inconsistent-missing-override

Diagnostics:
  # Suppress specific clangd diagnostics to reduce noise
  Suppress:
    - "use of undeclared identifier"
    - "unknown type name"
    - "no member named"
    - "IncludeCleaner"

  # Don't show unused include warnings
  UnusedIncludes: None
  MissingIncludes: None

# For better IntelliSense, generate compile_commands.json:
# In your Unreal project directory:
#   UnrealBuildTool -mode=GenerateClangDatabase -project="YourProject.uproject" -game -engine
