[core]
	excludesfile = ~/.gitignore
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	light = false
	side-by-side = false
	line-numbers = true
	syntax-theme = gruvbox-dark

[delta "gruvbox-dark"]
	minus-style = syntax "#3c1f1e"
	minus-emph-style = syntax "#9d0006"
	plus-style = syntax "#32361a"
	plus-emph-style = syntax "#79740e"
	hunk-header-style = syntax bold
	hunk-header-decoration-style = "#665c54" box
	file-style = "#ebdbb2" bold
	file-decoration-style = "#ebdbb2" ul
	line-numbers-minus-style = "#fb4934"
	line-numbers-plus-style = "#b8bb26"
	line-numbers-left-style = "#665c54"
	line-numbers-right-style = "#665c54"

[merge]
	conflictstyle = diff3

[diff]
	colorMoved = default

[init]
	defaultBranch = main

[pull]
	rebase = false

[push]
	autoSetupRemote = true
[user]
	email = brettfowle@gmail.com
	name = bfowle
