# ============================================
# Modern Tmux Configuration
# ============================================

# True color support
# Use screen-256color for better compatibility
set -g default-terminal "screen-256color"
set -ga terminal-overrides ",xterm-256color:RGB"
set -ga terminal-overrides ",screen-256color:RGB"
set -ga terminal-overrides ",tmux-256color:RGB"

# Terminal features for newer tmux versions
set -as terminal-features ",xterm-256color:RGB"
set -as terminal-features ",screen-256color:RGB"
set -as terminal-features ",tmux-256color:RGB"

# Vi mode
set-window-option -g mode-keys vi

# Scrollback buffer
set-option -g history-limit 10000

# Mouse support
set -g mouse on

# Start windows and panes at 1, not 0
set -g base-index 1
setw -g pane-base-index 1

# Renumber windows when one is closed
set -g renumber-windows on

# Window sizing - use latest (most recently used client size)
# Note: 'manual' is broken in tmux 3.4 and causes server crashes
set -g window-size latest

# Disable aggressive resize - causes [0/0] scrollback issues
# Note: tmux-sensible plugin re-enables this, so we use hooks to keep it disabled (see bottom of file)
set-window-option -g aggressive-resize off

# Disable alternate screen - prevents [0/0] scrollback issues
# Programs like vim/less/man use alternate screen which has no scrollback by design
# With this off, all output stays in main buffer and is scrollable
set-window-option -g alternate-screen off

# Minimize escape delay (important for neovim)
# Set to 10ms (recommended for neovim) - 0 can cause escape sequence corruption
set -s escape-time 10

# Enable focus events (required for neovim autoread)
set-option -g focus-events on

# ============================================
# Prefix Key
# ============================================

# Remap prefix to Control + a
set -g prefix C-a
unbind C-b
bind C-a send-prefix

# ============================================
# Key Bindings
# ============================================

# Reload config file
bind-key r source-file ~/.tmux.conf \; display-message "Config reloaded!"

# Split panes (both traditional and modern bindings)
# Traditional bindings
bind % split-window -h -c "#{pane_current_path}"
bind '"' split-window -v -c "#{pane_current_path}"
# Modern bindings (visual mnemonics)
bind | split-window -h -c "#{pane_current_path}"
bind - split-window -v -c "#{pane_current_path}"

# Quick pane cycling
bind C-A select-pane -t :.+

# Pane selection (vim-style)
bind h select-pane -L
bind j select-pane -D
bind k select-pane -U
bind l select-pane -R

# Pane selection by number
bind 0 select-pane -t 0
bind 1 select-pane -t 1
bind 2 select-pane -t 2
bind 3 select-pane -t 3
bind 4 select-pane -t 4
bind 5 select-pane -t 5
bind 6 select-pane -t 6
bind 7 select-pane -t 7
bind 8 select-pane -t 8
bind 9 select-pane -t 9

# Pane resizing
bind -r C-h resize-pane -L 5
bind -r C-j resize-pane -D 5
bind -r C-k resize-pane -U 5
bind -r C-l resize-pane -R 5

# Window navigation
bind-key -r C-h select-window -t :-
bind-key -r C-l select-window -t :+

# Rename window (prefix + ,)
bind , command-prompt -I "#W" "rename-window '%%'"

# Toggle pane maximizing
unbind z
bind = resize-pane -Z

# ============================================
# Copy Mode (Vi-style)
# ============================================

# Enter copy mode with prefix + [
bind [ copy-mode

# Note: Copy/paste is handled by tmux-yank plugin (configured below with TPM)
# The plugin handles vi-mode bindings (v, y, Enter) and mouse selection automatically

# Paste with prefix + ] (using Windows clipboard via PowerShell)
bind ] run "powershell.exe -command Get-Clipboard | tmux load-buffer - ; tmux paste-buffer"

# ============================================
# Status Bar Configuration
# ============================================

set-option -g status on
set-option -g status-interval 2
set-option -g status-justify "centre"
set-option -g status-left-length 60
set-option -g status-right-length 90

# Status bar will be styled by gruvbox theme plugin

# ============================================
# TPM - Tmux Plugin Manager
# ============================================

# List of plugins
set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-sensible'
set -g @plugin 'tmux-plugins/tmux-yank'
set -g @plugin 'tmux-plugins/tmux-resurrect'
set -g @plugin 'tmux-plugins/tmux-continuum'
set -g @plugin 'egel/tmux-gruvbox'

# Gruvbox theme
set -g @tmux-gruvbox 'dark' # or 'light'

# tmux-yank configuration (WSL clipboard integration)
# Disable mouse auto-copy - let terminal handle Ctrl+Shift+C
set -g @yank_selection_mouse 'disabled'  # Don't auto-copy on mouse selection
# Use iconv to convert UTF-8 to UTF-16LE for Windows clipboard (fixes UTF-8 characters)
set -g @override_copy_command 'iconv -f UTF-8 -t UTF-16LE | clip.exe'
set -g @yank_action 'copy-pipe'  # Copy and show visual feedback in vi-mode
set -g @yank_with_mouse off  # Disable mouse integration - use terminal's Ctrl+Shift+C

# Resurrect settings
set -g @resurrect-strategy-nvim 'session'
set -g @resurrect-capture-pane-contents 'on'

# Continuum settings (auto-save sessions)
set -g @continuum-restore 'on'
set -g @continuum-save-interval '15' # minutes

# ============================================
# Initialize TPM (keep at bottom)
# ============================================

# Note: TPM is installed automatically by the dotfiles install.sh script
# To manually install TPM and plugins, run:
#   git clone https://github.com/tmux-plugins/tpm ~/.tmux/plugins/tpm
#   ~/.tmux/plugins/tpm/bin/install_plugins

# Initialize TMUX plugin manager (keep this line at the very bottom of tmux.conf)
run '~/.tmux/plugins/tpm/tpm'

# Override tmux-sensible defaults using hooks (bulletproof - persists across all events)
# tmux-sensible unconditionally enables aggressive-resize, we disable it after every event
set-hook -g after-refresh-client 'set-window-option -g aggressive-resize off'
set-hook -g client-attached 'set-window-option -g aggressive-resize off'
set-hook -g client-session-changed 'set-window-option -g aggressive-resize off'

# Also set directly after TPM loads (hooks only run on events, this runs on source-file)
set-window-option -g aggressive-resize off
set-window-option -g alternate-screen off

# Unbind tmux-yank mouse copy bindings - we'll handle copy manually
unbind-key -T copy-mode MouseDragEnd1Pane
unbind-key -T copy-mode-vi MouseDragEnd1Pane
unbind-key -T root DoubleClick1Pane
unbind-key -T root TripleClick1Pane

# Restore mouse drag to enter copy-mode (we previously unbound it)
# This is tmux's default behavior - needed for mouse selection to work
bind-key -T root MouseDrag1Pane if-shell -F '#{||:#{pane_in_mode},#{mouse_any_flag}}' 'send-keys -M' 'copy-mode -M'

# Note: Mouse drag will show [line/total] indicator when entering copy-mode
# But all exit keys (y, Escape, q) work immediately to dismiss it

# Copy mode bindings - always exit after copy
bind-key -T copy-mode C-S-c send-keys -X copy-pipe-and-cancel "iconv -f UTF-8 -t UTF-16LE | clip.exe"
bind-key -T copy-mode-vi C-S-c send-keys -X copy-pipe-and-cancel "iconv -f UTF-8 -t UTF-16LE | clip.exe"

# Vi-mode: 'y' should copy AND exit (override tmux-yank's copy-pipe)
bind-key -T copy-mode-vi y send-keys -X copy-pipe-and-cancel "iconv -f UTF-8 -t UTF-16LE | clip.exe"

# Vi-mode: Escape should exit copy-mode (not just clear selection)
bind-key -T copy-mode-vi Escape send-keys -X cancel

# Vi-mode: q should exit copy-mode immediately
bind-key -T copy-mode-vi q send-keys -X cancel
